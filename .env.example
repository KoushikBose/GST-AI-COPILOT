# ==============================================================================
# GST AI Copilot — Environment Configuration
# Copy this file to .env and fill in values. Never commit the real .env file.
# ==============================================================================

# ---- Application ----
APP_ENV=development                 # development | staging | production
APP_NAME=GST AI Copilot
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO
LOG_FORMAT=json                     # json | console

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gst_copilot
POSTGRES_USER=gst_copilot
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql+asyncpg://gst_copilot:change-me-postgres-password@localhost:5432/gst_copilot
DATABASE_URL_SYNC=postgresql+psycopg://gst_copilot:change-me-postgres-password@localhost:5432/gst_copilot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=0
REDIS_CELERY_BROKER_DB=1
REDIS_CELERY_BACKEND_DB=2
REDIS_RATE_LIMIT_DB=3

# ---- Qdrant ----
# Set QDRANT_LOCAL_PATH to run an embedded on-disk Qdrant (no server / cloud
# cluster needed; single-process only). When set, QDRANT_URL is ignored.
# QDRANT_LOCAL_PATH=.data/qdrant
QDRANT_API_KEY=change-me-qdrant-cloud-api-key
QDRANT_CLUSTER_ENDPOINT=https://your-cluster-id.region.gcp.cloud.qdrant.io
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=false

# ---- MinIO / Object Storage (S3-compatible) ----
# "minio" = S3-compatible service at OBJECT_STORAGE_ENDPOINT.
# "filesystem" = store uploads as local files under
# OBJECT_STORAGE_FILESYSTEM_ROOT (no external service needed; dev/CI only).
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_FILESYSTEM_ROOT=.data/object-storage
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=gst_copilot_admin
OBJECT_STORAGE_SECRET_KEY=change-me-minio-secret
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET_DOCUMENTS=gst-documents
OBJECT_STORAGE_BUCKET_INVOICES=invoices
OBJECT_STORAGE_BUCKET_SUPPORTING=supporting-documents
OBJECT_STORAGE_BUCKET_KNOWLEDGE=knowledge-documents
OBJECT_STORAGE_BUCKET_EXPORTS=exports
OBJECT_STORAGE_BUCKET_BACKUPS=backups

# ---- Ollama (LLM runtime) ----
LLM_PROVIDER=ollama                 # ollama | openai | azure_openai | anthropic | bedrock (future)
OLLAMA_BASE_URL=http://localhost:11434
# To use Ollama Cloud (https://ollama.com/settings/keys) instead of a local
# install, set OLLAMA_BASE_URL=https://ollama.com and provide OLLAMA_API_KEY.
OLLAMA_API_KEY=change-me-ollama-cloud-api-key
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=8192
CHAT_REQUEST_TIMEOUT_SECONDS=45
HF_TOKEN=change-me-huggingface-token

# Optional cloud providers (not required; interfaces exist for future use)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Embeddings ----
EMBEDDING_PROVIDER=fastembed        # fastembed (local, open-source) | ollama
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# ---- Reranker ----
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_K=8

# ---- OCR ----
OCR_PROVIDER=tesseract               # tesseract | paddleocr (needs the ocr-paddle extra)
OCR_LANGUAGE=en
TESSERACT_CMD=

# ---- Celery / Background workers ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ---- Auth / JWT ----
JWT_SECRET=change-me-jwt-secret-must-be-long-and-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute

# ---- File upload limits ----
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,tiff,docx,xlsx,csv,txt,json

# ---- Observability ----
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=gst-ai-copilot-api
PROMETHEUS_ENABLED=true
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=gst-ai-copilot

# ---- GST Rule Engine ----
GST_RULES_VERSION=2026.01
GST_ROUNDING_MODE=ROUND_HALF_UP
